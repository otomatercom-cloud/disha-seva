# Placeholders only. Never commit real values. Server-side only (no NEXT_PUBLIC_ prefix).

# Base URL of the Odoo 19 server (https in production)
ODOO_BASE_URL=https://your-odoo-domain.example
# Optional: only needed if Odoo hosts several databases and no dbfilter is set
ODOO_DATABASE=
# Value of the Odoo system parameter disha_membership.api_token
ODOO_API_TOKEN=replace-with-token-from-odoo
# Odoo request timeout in milliseconds
ODOO_TIMEOUT_MS=10000

# Public site URL, used for the same-origin check on form submissions
SITE_URL=https://your-site-domain.example

# Rate limit per client IP: max requests per window (ms)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Website content (edited in Odoo > Website Content). Cached for this many seconds.
CONTENT_REVALIDATE_S=30
CONTENT_TIMEOUT_MS=3000
# Public URL of Odoo for uploaded photos/PDFs, if different from ODOO_BASE_URL
ODOO_PUBLIC_URL=
