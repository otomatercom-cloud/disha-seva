<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disha_registration_list" model="ir.ui.view">
        <field name="name">disha.membership.application.list</field>
        <field name="model">disha.membership.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="registration_date"/>
                <field name="full_name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="category"/>
                <field name="ksa_city"/>
                <field name="source" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'" decoration-warning="state == 'under_review'"
                       decoration-primary="state == 'contacted'" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_disha_registration_form" model="ir.ui.view">
        <field name="name">disha.membership.application.form</field>
        <field name="model">disha.membership.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" string="Start Review" type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_contact" string="Mark Contacted" type="object"
                            invisible="state not in ('new', 'under_review')"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success"
                            groups="disha_membership.group_disha_membership_manager"
                            invisible="state not in ('under_review', 'contacted')"/>
                    <button name="action_reject" string="Reject" type="object"
                            groups="disha_membership.group_disha_membership_manager"
                            invisible="state in ('approved', 'rejected')"/>
                    <button name="action_reset" string="Reset to New" type="object"
                            groups="disha_membership.group_disha_membership_manager"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,under_review,contacted,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="duplicate_count == 0">
                        Another application shares this email or mobile number.
                        This may be a legitimate family or shared contact; review before acting.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="group_personal" string="Personal Information">
                            <field name="category"/>
                            <field name="full_name"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="nationality"/>
                            <field name="blood_group"/>
                            <field name="qualification"/>
                            <field name="occupation"/>
                            <field name="organization"/>
                        </group>
                        <group name="group_contact" string="Contact &amp; KSA Details">
                            <field name="mobile" widget="phone"/>
                            <field name="whatsapp" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="ksa_region"/>
                            <field name="ksa_city"/>
                            <field name="iqama_number"/>
                            <field name="passport_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address in India" name="page_india">
                            <group>
                                <group>
                                    <field name="india_state"/>
                                    <field name="india_district"/>
                                    <field name="india_village"/>
                                    <field name="india_pin"/>
                                </group>
                                <group>
                                    <field name="india_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Emergency Contacts" name="page_emergency">
                            <group>
                                <group string="In KSA">
                                    <field name="ksa_emergency_name"/>
                                    <field name="ksa_emergency_relationship"/>
                                    <field name="ksa_emergency_phone" widget="phone"/>
                                </group>
                                <group string="In India">
                                    <field name="india_emergency_name"/>
                                    <field name="india_emergency_relationship"/>
                                    <field name="india_emergency_phone" widget="phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Declaration" name="page_info">
                            <group>
                                <group name="group_reginfo">
                                    <field name="registration_date"/>
                                    <field name="source"/>
                                    <field name="consent_given"/>
                                    <field name="consent_date"/>
                                </group>
                                <group name="group_office" string="For Office Use">
                                    <field name="approved_on"/>
                                    <field name="approved_by_id"/>
                                    <field name="duplicate_count"/>
                                </group>
                            </group>
                            <group>
                                <field name="why_join"/>
                            </group>
                        </page>
                        <page string="Internal Notes" name="page_notes">
                            <field name="internal_notes" placeholder="Staff-only notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_disha_registration_search" model="ir.ui.view">
        <field name="name">disha.membership.application.search</field>
        <field name="model">disha.membership.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference / Name / Contact"
                       filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('full_name', 'ilike', self), ('email', 'ilike', self), ('mobile', 'ilike', self), ('whatsapp', 'ilike', self)]"/>
                <field name="category"/>
                <field name="ksa_region"/>
                <field name="ksa_city"/>
                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="Under Review" name="filter_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Contacted" name="filter_contacted" domain="[('state', '=', 'contacted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Registered This Month" name="filter_month"
                        domain="[('registration_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="From Website" name="filter_website" domain="[('source', '=', 'website')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'ksa_city'}"/>
                    <filter string="Region" name="group_region" context="{'group_by': 'ksa_region'}"/>
                    <filter string="Registration Month" name="group_month" context="{'group_by': 'registration_date:month'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_disha_registration" model="ir.actions.act_window">
        <field name="name">Membership Applications</field>
        <field name="res_model">disha.membership.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_disha_registration_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
    </record>
</odoo>
